        # Add BL button
        self.add_bl_btn = ttk.Button(controls_frame, text="+ Nouveau BL", 
                                    command=self.add_bon_livraison)
        self.add_bl_btn.pack(side=tk.LEFT, padx=(0, 10))
        disable_button_if_no_permission(self.add_bl_btn, "bon_livraison", "create")
        
        # Delete BL button
